# Copy to .env and fill in. .env is gitignored and must never be committed.

# Path to a local GGUF instruction model.
COMPLAINT_MODEL_PATH=./models/mistral-7b-instruct.Q4_K_M.gguf

# Hugging Face token, used only to download model weights.
COMPLAINT_HF_TOKEN=

# Generation settings. Temperature 0 because a routing decision should not
# vary between runs of the same input.
COMPLAINT_MAX_TOKENS=1200
COMPLAINT_TEMPERATURE=0
COMPLAINT_TOP_P=0.95
COMPLAINT_TOP_K=50
COMPLAINT_REPEAT_PENALTY=1.2
COMPLAINT_CONTEXT_LENGTH=4096

COMPLAINT_SEED=42
COMPLAINT_LOG_LEVEL=INFO
